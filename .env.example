# Copy to .env (docker compose reads it) and adjust.
# Folder with the videos to publish.
PUBLISH_HOST_DIR=/Users/gs/Desktop/GS/PROYECTOS/To Primitive/Reels
# Photos and videos to turn into reels automatically.
INPUT_HOST_DIR=/Users/gs/Desktop/GS/PROYECTOS/To Primitive/Entrada
# Where the automatically generated reels go (kept apart from Reels).
GENERATED_HOST_DIR=/Users/gs/Desktop/GS/PROYECTOS/To Primitive/Generados

# Who writes titles, descriptions, tags and translations of generated reels
# (it can also be chosen on the Generar page):
# - Claude: your Anthropic API key (https://console.anthropic.com).
ANTHROPIC_API_KEY=
# - Or a local model with an OpenAI-compatible API (Ollama, LM Studio...).
#   Ollama: http://host.docker.internal:11434/v1 · LM Studio: http://host.docker.internal:1234/v1
LLM_BASE_URL=
# Model name (empty: claude-opus-5-5 for Claude; for a local model, the one you downloaded, e.g. llama3.1).
LLM_MODEL=
