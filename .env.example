# Copy to .env (docker compose reads it) and adjust.
# Folder with the videos to publish.
PUBLISH_HOST_DIR=/Users/gs/Desktop/GS/PROYECTOS/To Primitive/Reels
# Photos and videos to turn into reels automatically.
INPUT_HOST_DIR=/Users/gs/Desktop/GS/PROYECTOS/To Primitive/Entrada
# Where the automatically generated reels go (kept apart from Reels).
GENERATED_HOST_DIR=/Users/gs/Desktop/GS/PROYECTOS/To Primitive/Generados
# Audio bank: songs to pick from in the reel editor (subfolders too).
AUDIOS_HOST_DIR=/Users/gs/Desktop/GS/PROYECTOS/To Primitive/Audios

# Who writes titles, descriptions, tags and translations of generated reels
# (it can also be chosen on the Generar page):
# - Claude: your Anthropic API key (https://console.anthropic.com).
ANTHROPIC_API_KEY=
# - Or a local model with an OpenAI-compatible API (Ollama, LM Studio...).
#   Ollama: http://host.docker.internal:11434/v1 · LM Studio: http://host.docker.internal:1234/v1
LLM_BASE_URL=
# Local model name: the one you downloaded, e.g. llama3.1.
LLM_MODEL=
# Claude model (empty: claude-opus-5-5).
CLAUDE_MODEL=

# Publishing for real (see README, "Publicar en YouTube y TikTok"). The
# accounts are connected from the Publicar page; the app's credentials go here.
# YouTube: Google Cloud > OAuth client "Web application", with the redirect URI
# http://localhost:8080/api/publish/oauth/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# TikTok: TikTok for Developers app with Login Kit + Content Posting API.
# TikTok wants an https redirect URI: register the GitHub Pages page that
# forwards to this app (docs/tiktok/callback.html) and put the same here.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://guidodsalem.github.io/To-Primitive/tiktok/callback.html
